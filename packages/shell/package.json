{
  "name": "@ed/shell",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Eldritch Dynasty. Owns the window and the disk; owns no rules.",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mod-editor": "node scripts/dev.mjs --mod-editor",
    "start": "electron .",
    "preview": "npm run build --workspace @ed/client && electron .",
    "smoke": "electron . --smoke",
    "dist:windows": "node scripts/dist-windows.mjs"
  },
  "devDependencies": {
    "@ed/content": "*",
    "@ed/core": "*",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  }
}
