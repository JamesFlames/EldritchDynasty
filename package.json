{
  "name": "eldritch-dynasty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ed/editor",
    "build": "npm run build --workspace @ed/editor",
    "shell": "npm run dev --workspace @ed/shell",
    "shell:preview": "npm run preview --workspace @ed/shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:core && npm run typecheck:editor",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "//1": "vue-tsc reads TEMPLATES. Plain tsc cannot, and a template error is always silent — the click lands and nothing happens.",
    "typecheck:editor": "vue-tsc --noEmit -p packages/editor/tsconfig.json",

    "//2": "One command before you claim anything works.",
    "check": "npm run typecheck && npm run validate && npm test",
    "validate": "tsx --tsconfig tsconfig.base.json packages/core/src/tools/validate.ts",
    "harness": "tsx --tsconfig tsconfig.base.json packages/core/src/harness.ts",
    "digest": "tsx --tsconfig tsconfig.base.json packages/core/src/tools/digest.ts",
    "gen:loci": "node packages/content/tools/gen-loci.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.9"
  }
}
